<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="700.0" stylesheets="@Fondo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MenuController" styleClass="fondo_final">

   <children>
      <VBox alignment="CENTER"
            spacing="20.0"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <Label fx:id="lblGanador"
                text="Victoria"
                styleClass="titulo_victoria"/>

         <Button text="Iniciar nueva partida"
                 onAction="#jugar"
                 styleClass="boton_menu" />

         <Button text="Salir"
                 onAction="#salir"
                 styleClass="boton_menu" />

      </VBox>
   </children>

</AnchorPane>